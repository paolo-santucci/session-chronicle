{
  "_comment": "session-chronicle hooks. Merge this 'hooks' object into the target project's .claude/settings.json (or settings.local.json). sync-claude.sh does NOT manage settings, so this registration is a one-time per-target step (automated later by the M3 session-memory-bootstrap skill). Hooks run arbitrary code with your user permissions and require approval on first use.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/session-chronicle/scripts/retrieve-inject.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/session-chronicle/scripts/capture-signals.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/session-chronicle/scripts/topic-index.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/session-chronicle/scripts/note-lint.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/session-chronicle/scripts/note-lint.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/session-chronicle/scripts/capture-signals.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/session-chronicle/scripts/checkpoint-nudge.py\""
          }
        ]
      }
    ]
  }
}
