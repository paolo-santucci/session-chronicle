{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["index.ts", "index.test.ts", "adapters/**/*.ts", "tests/**/*.ts"],
  "exclude": ["adapters/**/entry.ts"]
}
